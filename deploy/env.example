# Server environment for Fantas.ai. setup.sh copies this to /opt/fantasai/.env (mode 600).
# Fill in every REQUIRED line, then run deploy/push.sh from your laptop.
# config.py finds this file by walking up from backend/, so it must stay at /opt/fantasai/.env.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME   # same Neon URL as your laptop
GEMINI_API_KEY=                                              # gitleaks:allow (template: empty on purpose)
CLERK_PUBLISHABLE_KEY=                                       # the pk_test_... key while on Clerk dev keys
CLERK_SECRET_KEY=                                            # sk_test_...; unset would DISABLE auth entirely
CLERK_ADMIN_IDS=                                             # your Clerk user id, so you can approve friends
# Your Vercel URL, exactly, no trailing slash. Drives CORS AND the Clerk azp check, so
# sign-in from the deployed site fails until this matches.
ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
# MUST be the same value as your laptop's .env. A different key does not lose data, it
# just makes every user reconnect ESPN.
ESPN_COOKIE_KEY=

# ── SERVER BEHAVIOUR ─────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true            # only on the server; your laptop should run it false while this is live
LLM_ENABLED=true

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=                  # the Tape page; without it Tape is empty, nothing else changes
# GEMINI_PRIMARY / GEMINI_FALLBACK / LLM_DAILY_CALL_CAP / GEMINI_PRIMARY_RPD /
# GEMINI_FALLBACK_RPD / SCHEDULER_ADP_HOUR / SCHEDULER_SENTIMENT_HOUR all have defaults.
# ESPN_LEAGUE_ID / ESPN_S2 / SWID / SLEEPER_USERNAME are single-league leftovers; leave unset.
