# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Database (Neon serverless Postgres) ──────────────────────────────────────
# MUST use the asyncpg driver prefix for the app. Alembic swaps it to psycopg2.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ── Google Gemini (AI analysis) ──────────────────────────────────────────────
GEMINI_API_KEY=
# Optional, powers the Tape page. A separate Google key restricted to YouTube Data API
# v3, deliberately not the Gemini key: widening that one's scope would let a leak burn
# LLM quota. Unset just turns the page off.
YOUTUBE_API_KEY=
# Optional model overrides (defaults are the current free Flash-class models):
# GEMINI_PRIMARY=gemini-3.1-flash-lite
# GEMINI_FALLBACK=gemini-3.7-flash

# ── ESPN Fantasy (cookie auth, from Chrome DevTools → Application → Cookies) ──────
ESPN_LEAGUE_ID=
ESPN_S2=
SWID=

# ── Sleeper ──────────────────────────────────────────────────────────────────
SLEEPER_USERNAME=

# ── Clerk auth ───────────────────────────────────────────────────────────────
# From Clerk dashboard → API Keys. Publishable is safe client-side; secret is not.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs that are auto-approved + treated as admins.
CLERK_ADMIN_IDS=

# ── Toggles (optional) ───────────────────────────────────────────────────────
# Halt all Gemini calls (news + tracker fall back to rule-based signals):
# LLM_ENABLED=true
# Hard daily ceiling on Gemini calls (protects the free-tier key):
# LLM_DAILY_CALL_CAP=1200
